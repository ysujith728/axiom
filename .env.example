# ==============================================================================
# AXIOM Environment Configuration Template
# ==============================================================================
# AXIOM is local-first. Core functionality operates without external paid APIs.
# Copy this file to .env for local development customization.
# ==============================================================================

# Application Environment
NODE_ENV=development
LOG_LEVEL=info

# Desktop App & IPC Server
AXIOM_DESKTOP_PORT=5173
AXIOM_IPC_CHANNEL=axiom-ipc-socket

# Local AI Endpoints (Ollama default)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=llama3.2:3b
DEFAULT_FAST_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=all-minilm:latest

# Hardware Limits (tuned for 16GB RAM / 2GB VRAM / i7-1355U)
AXIOM_MAX_MEMORY_MB=12288
AXIOM_MAX_VRAM_MB=1800
AXIOM_MAX_CONCURRENT_TASKS=3
AXIOM_CPU_WORKERS=4

# Local Storage & Database
AXIOM_DATA_DIR=./data
DATABASE_URL=file:./data/axiom.db

# Voice Subsystem
VOICE_WORKER_ENABLED=false
VOICE_WAKEWORD_MODEL=hey_axiom
VOICE_STT_ENGINE=faster-whisper
VOICE_TTS_ENGINE=piper

# Vision & Automation Subsystem
VISION_WORKER_ENABLED=false
PLAYWRIGHT_HEADLESS=false

# Security & Safety Guards
AXIOM_SECURITY_STRICT_MODE=true
AXIOM_AUTO_APPROVE_SAFE_TOOLS=true
AXIOM_CONFIRM_FILE_MODIFICATIONS=true
AXIOM_CONFIRM_DELETIONS=true
